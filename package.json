{
  "name": "slidev-theme-alchemmist",
  "version": "0.4.0",
  "description": "An academic engineering theme for Slidev",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "slidev example/slides.md --open",
    "build": "slidev build example/slides.md --out dist",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/*.test.ts",
    "test:visual": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "pack:check": "node scripts/check-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:visual && pnpm pack:check",
    "prepublishOnly": "pnpm check"
  },
  "author": "alchemmist <anton.ingrish@gmail.com>",
  "license": "MIT",
  "files": [
    "components",
    "layouts",
    "styles",
    "setup",
    "theme",
    "global-bottom.vue",
    "global-top.vue",
    "layoutHelper.ts",
    "public",
    "CHANGELOG.md",
    "FONT-NOTICES.md",
    "MIGRATION.md"
  ],
  "funding": "https://alchemmist.xyz",
  "homepage": "https://sli.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemmist/slidev-theme-alchemmist.git"
  },
  "bugs": "https://github.com/alchemmist/slidev-theme-alchemmist/issues",
  "keywords": [
    "slidev-theme",
    "slidev",
    "alchemmist"
  ],
  "slidev": {
    "defaults": {
      "favicon": "/assets/alchemmist-logo.svg",
      "mdc": true,
      "comark": true,
      "transition": "slide-left",
      "themeConfig": {
        "accent": "#5d3fd3",
        "pagination": true,
        "paginationPosition": "top-right",
        "footer": true
      },
      "fonts": {
        "sans": "CMU-Roman",
        "serif": "CMU-Roman",
        "mono": "CMU-Typewriter",
        "provider": "none"
      }
    }
  },
  "dependencies": {
    "codemirror-theme-vars": "^0.1.2",
    "prism-theme-vars": "^0.2.5",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "@slidev/client": "^52.19.1",
    "@slidev/types": "^52.19.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@slidev/cli": "^52.19.1",
    "@slidev/client": "^52.19.1",
    "@slidev/types": "^52.19.1",
    "@types/node": "^24.0.0",
    "@vitest/eslint-plugin": "^1.3.17",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-slidev": "^1.0.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "unocss": "^66.5.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.41",
    "vue-tsc": "^3.2.0"
  }
}
